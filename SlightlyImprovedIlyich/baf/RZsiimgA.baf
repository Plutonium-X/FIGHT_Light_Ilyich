IF
	Global("RZ_Create_Scroll","LOCALS",0)
	OR(2)
		Name("RZsiiT01",Myself)  // Shadow Thief
		Name("RZsiiT04",Myself)  // Shadow Thief
THEN
	RESPONSE #100
		SetGlobal("RZ_Create_Scroll","LOCALS",1)
		GiveItemCreate("SCRL7I",Myself,1,1,0)  // Death Spell
		Continue()
	RESPONSE #100
		SetGlobal("RZ_Create_Scroll","LOCALS",1)
		GiveItemCreate("SCRL7S",Myself,1,1,0)  // Chain Lightning
		Continue()
	RESPONSE #100
		SetGlobal("RZ_Create_Scroll","LOCALS",1)
		GiveItemCreate("SCRL8B",Myself,1,1,0)  // Summon Nishruu
		Continue()
	RESPONSE #100
		SetGlobal("RZ_Create_Scroll","LOCALS",1)
		GiveItemCreate("SCRL7W",Myself,1,1,0)  // Wyvern Call
		Continue()
	RESPONSE #100
		SetGlobal("RZ_Create_Scroll","LOCALS",1)
		GiveItemCreate("SCRL7E",Myself,1,1,0)  // Invisible Stalker
		Continue()
	RESPONSE #100
		SetGlobal("RZ_Create_Scroll","LOCALS",1)
		Continue()
END

