IF
	!Allegiance(Myself,ENEMY)
	HaveSpell(CLERIC_ZONE_OF_SWEET_AIR)  // SPPR318.SPL (Zone of Sweet Air)
	!StateCheck(Myself,STATE_SILENCED)
	CheckStat(Myself,0,CLERIC_INSECT_PLAGUE)
	CheckStatLT(Myself,20,SPELLFAILUREPRIEST)
	OR(12)
		SpellCast([GOODCUTOFF.0.0.0.0.SUMMONED],WIZARD_STINKING_CLOUD)  // SPWI213.SPL (Stinking Cloud)
		SpellCast([PC],WIZARD_STINKING_CLOUD)  // SPWI213.SPL (Stinking Cloud)
		SpellCast([FAMILIAR],WIZARD_STINKING_CLOUD)  // SPWI213.SPL (Stinking Cloud)
		SpellCast([ALLY],WIZARD_STINKING_CLOUD)  // SPWI213.SPL (Stinking Cloud)
		SpellCast([CONTROLLED],WIZARD_STINKING_CLOUD)  // SPWI213.SPL (Stinking Cloud)
		SpellCast([CHARMED],WIZARD_STINKING_CLOUD)  // SPWI213.SPL (Stinking Cloud)
		SpellCast([GOODCUTOFF.0.0.0.0.SUMMONED],WIZARD_CLOUDKILL)  // SPWI502.SPL (Cloudkill)
		SpellCast([PC],WIZARD_CLOUDKILL)  // SPWI502.SPL (Cloudkill)
		SpellCast([FAMILIAR],WIZARD_CLOUDKILL)  // SPWI502.SPL (Cloudkill)
		SpellCast([ALLY],WIZARD_CLOUDKILL)  // SPWI502.SPL (Cloudkill)
		SpellCast([CONTROLLED],WIZARD_CLOUDKILL)  // SPWI502.SPL (Cloudkill)
		SpellCast([CHARMED],WIZARD_CLOUDKILL)  // SPWI502.SPL (Cloudkill)
THEN
	RESPONSE #100
		Enemy()
		EquipMostDamagingMelee()
		SetGlobal("RZ_See_Enemy","LOCALS",1)
		SetGlobal("RZ_Under_Attack","MYAREA",1)
		SetGlobalTimer("RZ_Action_Timer","LOCALS",6)
		Spell(Myself,CLERIC_ZONE_OF_SWEET_AIR)  // SPPR318.SPL (Zone of Sweet Air)
		Continue()
END

IF
	!Allegiance(Myself,ENEMY)
	OR(19)
		Global("RZ_Under_Attack","MYAREA",1)
		AttackedBy([GOODCUTOFF.0.0.0.0.SUMMONED],DEFAULT)
		AttackedBy([PC],DEFAULT)
		AttackedBy([FAMILIAR],DEFAULT)
		AttackedBy([ALLY],DEFAULT)
		AttackedBy([CONTROLLED],DEFAULT)
		AttackedBy([CHARMED],DEFAULT)
		HitBy([GOODCUTOFF.0.0.0.0.SUMMONED],CRUSHING)
		HitBy([PC],CRUSHING)
		HitBy([FAMILIAR],CRUSHING)
		HitBy([ALLY],CRUSHING)
		HitBy([CONTROLLED],CRUSHING)
		HitBy([CHARMED],CRUSHING)
		SpellCastOnMe([GOODCUTOFF.0.0.0.0.SUMMONED],0)
		SpellCastOnMe([PC],0)
		SpellCastOnMe([FAMILIAR],0)
		SpellCastOnMe([ALLY],0)
		SpellCastOnMe([CONTROLLED],0)
		SpellCastOnMe([CHARMED],0)
THEN
	RESPONSE #100
		Enemy()
		SetGlobal("RZ_See_Enemy","LOCALS",1)
		SetGlobal("RZ_Under_Attack","MYAREA",1)
		Continue()
END

IF
	Global("RZ_Can_Melee","LOCALS",0)
