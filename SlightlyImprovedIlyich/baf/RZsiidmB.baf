IF
	Allegiance(LastSeenBy(Myself),PC)
THEN
	RESPONSE #100
		EquipMostDamagingMelee()
		SetGlobalTimer("RZ_Action_Timer","LOCALS",6)
		UseItem("SCRL1I",LastSeenBy(Myself))  // Hold Person
END

